{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conventions": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "description": "Branch name template, e.g. {child_iid}-{slug}.",
          "type": "string"
        },
        "child_body": {
          "type": "string"
        },
        "child_issue": {
          "description": "auto creates a child issue when the tracker project differs from the code repo.",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "type": "string"
        },
        "child_title": {
          "type": "string"
        },
        "commit_prefix": {
          "description": "Prefix for the first commit of an MR (and a squash merge message) that ADE makes, e.g. \"GL-{parent}\". Placeholders: {parent} (tracker issue iid), {child} (child issue iid, else the branch's leading number, else the parent's), {project}.",
          "type": "string"
        },
        "link": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mr": {
          "additionalProperties": false,
          "properties": {
            "closes": {
              "type": "string"
            },
            "create": {
              "description": "Whether start work creates the MR: ask, always or never.",
              "enum": [
                "ask",
                "always",
                "never"
              ],
              "type": "string"
            },
            "draft": {
              "description": "Open the MR as a draft. Unset means true.",
              "type": "boolean"
            },
            "mention": {
              "type": "string"
            },
            "reviewer_group": {
              "description": "Group whose members start work asks to review the MR: a GitLab group path (acme/reviewers) or, on GitHub, org/team-slug of the repository's owner. Empty requests nobody.",
              "type": "string"
            },
            "template": {
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "dotfiles": {
      "additionalProperties": false,
      "description": "The team's dotfiles repository (the one used with `coder dotfiles`). `ade setup` and `ade dotfiles` clone it and run its install script, or symlink its dotfiles into $HOME. The install script is team code that runs with your environment.",
      "properties": {
        "branch": {
          "description": "Branch to check out (default: the repository's default branch).",
          "type": "string"
        },
        "install": {
          "description": "Script inside the repo to run, overriding the search for install.sh, install, bootstrap.sh, bootstrap, setup.sh, setup, script/install.sh, script/install, script/bootstrap.sh, script/bootstrap, script/setup.sh and script/setup.",
          "type": "string"
        },
        "repo": {
          "description": "Git URL of the dotfiles repository. A URL on a configured forge host is cloned with that forge's token.",
          "type": "string"
        },
        "symlink": {
          "description": "Link the repo's dotfiles into $HOME when no install script is found (default true).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "forge": {
      "description": "Key into the user config's [forges].",
      "type": "string"
    },
    "groups": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": "Named lists of nodes that workspaces run.",
      "type": "object"
    },
    "labels": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": {
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "workflow": {
          "additionalProperties": false,
          "properties": {
            "done": {
              "description": "Workflow value that marks an open tracker issue finished.",
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "stage": {
              "additionalProperties": {
                "type": "string"
              },
              "description": "Derived stage (started, draft, review, merged) to workflow label value.",
              "type": "object"
            },
            "sync": {
              "default": "ask",
              "description": "Whether ADE moves the workflow label when the derived stage changes: auto moves it, ask moves it only when you confirm (ade start --move-label, or the start dialog) and lists background moves as pending, off never moves it (default ask).",
              "enum": [
                "auto",
                "ask",
                "off"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "name": {
      "description": "Project name; becomes the directory under the projects root.",
      "type": "string"
    },
    "project": {
      "additionalProperties": false,
      "description": "Project-wide setup ADE generates under <root>/<project>/ on every add and update: agent guidance, a nix shell wrapper.",
      "properties": {
        "agents": {
          "description": "File relative to the manifest, written as <root>/<project>/AGENTS.md (the project's agent guidance). Needs a local or git+ manifest source.",
          "type": "string"
        },
        "nixpkgs": {
          "description": "Flake reference the packages come from (default: the registry's \"nixpkgs\").",
          "type": "string"
        },
        "packages": {
          "description": "nixpkgs attributes put on PATH for every pane, task and service of the project through <root>/<project>/.ade/shell (needs nix on PATH).",
          "items": {
            "description": "nixpkgs attributes put on PATH for every pane, task and service of the project through <root>/<project>/.ade/shell (needs nix on PATH).",
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "repo_groups": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "repos": {
            "description": "Repo names in the group; a repo may be in several groups.",
            "items": {
              "description": "Repo names in the group; a repo may be in several groups.",
              "type": "string"
            },
            "type": "array"
          },
          "workspace": {
            "description": "File stem of <root>/<project>/<workspace>.code-workspace, a VS Code multi-root workspace of the group's repos (baseline worktrees).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Display-only repo groups: `ade project status` lists repos under them and each group with a workspace gets a .code-workspace file. They never change routing, checkouts or the run graph.",
      "type": "object"
    },
    "repos": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "App-label values routed to this repo.",
            "items": {
              "description": "App-label values routed to this repo.",
              "type": "string"
            },
            "type": "array"
          },
          "default_branch": {
            "type": "string"
          },
          "devshell": {
            "description": "How a worktree's dev shell is entered for panes and tasks: auto (direnv with an .envrc, else nix develop with a flake devShell), direnv, nix or none.",
            "enum": [
              "auto",
              "direnv",
              "nix",
              "none"
            ],
            "type": "string"
          },
          "hooks": {
            "additionalProperties": false,
            "properties": {
              "install": {
                "description": "Shell commands that set a worktree up (npm ci). Run in each worktree of this repo a workspace uses, inside the repo's dev shell, in the services tab when the workspace first opens (background mode), and on ade ws install and ade ws up in either mode; re-run only when the commands or the worktree's lockfiles change. Runs with ADE's environment: same trust as post_worktree.",
                "items": {
                  "description": "Shell commands that set a worktree up (npm ci). Run in each worktree of this repo a workspace uses, inside the repo's dev shell, in the services tab when the workspace first opens (background mode), and on ade ws install and ade ws up in either mode; re-run only when the commands or the worktree's lockfiles change. Runs with ADE's environment: same trust as post_worktree.",
                  "type": "string"
                },
                "type": "array"
              },
              "post_clone": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "post_worktree": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "path": {
            "description": "Forge path, e.g. group/api.",
            "type": "string"
          },
          "requires": {
            "description": "Checkout dependencies (repo names).",
            "items": {
              "description": "Checkout dependencies (repo names).",
              "type": "string"
            },
            "type": "array"
          },
          "tasks": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "cmd": {
                  "type": "string"
                },
                "env": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Environment of the task; values may use {port}, {dir}, {state} and <node>.port templates.",
                  "type": "object"
                },
                "keep": {
                  "type": "boolean"
                },
                "kind": {
                  "enum": [
                    "service",
                    "oneshot"
                  ],
                  "type": "string"
                },
                "port": {
                  "oneOf": [
                    {
                      "const": "auto"
                    },
                    {
                      "maximum": 65535,
                      "minimum": 1,
                      "type": "integer"
                    }
                  ]
                },
                "ready": {
                  "additionalProperties": false,
                  "properties": {
                    "http": {
                      "type": "string"
                    },
                    "log": {
                      "type": "string"
                    },
                    "tcp": {
                      "type": "string"
                    },
                    "timeout": {
                      "examples": [
                        "10m",
                        "90s"
                      ],
                      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "requires": {
                  "description": "Node references: \"<repo>.<task>\" or \"services.<name>\".",
                  "items": {
                    "description": "Node references: \"<repo>.<task>\" or \"services.<name>\".",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "description": "Run-graph nodes of this repo.",
            "type": "object"
          },
          "url": {
            "description": "Explicit clone URL; overrides forge + path.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Repositories of the project.",
      "type": "object"
    },
    "services": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "type": "string"
          },
          "env": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "keep": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "service",
              "oneshot"
            ],
            "type": "string"
          },
          "port": {
            "oneOf": [
              {
                "const": "auto"
              },
              {
                "maximum": 65535,
                "minimum": 1,
                "type": "integer"
              }
            ]
          },
          "ready": {
            "additionalProperties": false,
            "properties": {
              "http": {
                "type": "string"
              },
              "log": {
                "type": "string"
              },
              "tcp": {
                "type": "string"
              },
              "timeout": {
                "examples": [
                  "10m",
                  "90s"
                ],
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "requires": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "description": "Shared infrastructure nodes that are not repos.",
      "type": "object"
    },
    "tracker": {
      "additionalProperties": false,
      "properties": {
        "board": {
          "type": "string"
        },
        "iterations": {
          "additionalProperties": false,
          "properties": {
            "cadence": {
              "type": "string"
            },
            "length": {
              "type": "string"
            },
            "overlap": {
              "description": "Working days around a boundary that show the adjacent sprint (default 1).",
              "type": "integer"
            },
            "pattern": {
              "type": "string"
            },
            "source": {
              "description": "Where sprints come from.",
              "enum": [
                "auto",
                "gitlab-iterations",
                "milestones",
                "labels",
                "github-project",
                "cadence"
              ],
              "type": "string"
            },
            "start": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "project": {
          "description": "Forge path of the tracker project.",
          "type": "string"
        },
        "weight": {
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string"
            },
            "pattern": {
              "type": "string"
            },
            "source": {
              "description": "Where issue weights come from.",
              "enum": [
                "auto",
                "gitlab",
                "label",
                "github-field",
                "none"
              ],
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "workspaces": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "layout": {
            "description": "Zellij tab layout.",
            "enum": [
              "code",
              "agent",
              "review",
              "manual"
            ],
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "services": {
            "default": "background",
            "description": "background (default) starts the run group's services in a tab of their own, after the install hooks, when the workspace first opens; manual keeps them in the workspace tab's strip, each waiting for Enter.",
            "enum": [
              "background",
              "manual"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Named workspaces: a layout and the run group to bring up.",
      "type": "object"
    }
  },
  "title": "ADE project manifest (*.ade.toml, *.ade.local.toml)",
  "type": "object"
}
